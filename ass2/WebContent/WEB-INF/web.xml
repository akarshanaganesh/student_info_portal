<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>StudentProfilePortal</display-name>
    <description>
        Student Profile Portal with Image and Document Streaming,
        MySQL JDBC Connectivity, Looping, and Session Security.
    </description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- ================================================================= -->
    <!-- TASK REQUIREMENT 5: Session Configuration                         -->
    <!-- ================================================================= -->
    <session-config>
        <!-- Invalidate inactive sessions after 30 minutes -->
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

    <!-- ================================================================= -->
    <!-- Authentication Filter Mapping                                     -->
    <!-- ================================================================= -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.portal.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ================================================================= -->
    <!-- Servlets Configuration                                            -->
    <!-- ================================================================= -->

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.portal.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.portal.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Student List Servlet (JDBC Fetch & Loop) -->
    <servlet>
        <servlet-name>StudentListServlet</servlet-name>
        <servlet-class>com.portal.servlet.StudentListServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StudentListServlet</servlet-name>
        <url-pattern>/StudentListServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StudentListServlet</servlet-name>
        <url-pattern>/students</url-pattern>
    </servlet-mapping>

    <!-- Image Stream Servlet (Retrieves & streams images for <img> tag) -->
    <servlet>
        <servlet-name>ImageStreamServlet</servlet-name>
        <servlet-class>com.portal.servlet.ImageStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ImageStreamServlet</servlet-name>
        <url-pattern>/ImageStreamServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ImageStreamServlet</servlet-name>
        <url-pattern>/imageStream</url-pattern>
    </servlet-mapping>

    <!-- Document Stream Servlet (Retrieves & streams documents/PDFs) -->
    <servlet>
        <servlet-name>DocumentStreamServlet</servlet-name>
        <servlet-class>com.portal.servlet.DocumentStreamServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DocumentStreamServlet</servlet-name>
        <url-pattern>/DocumentStreamServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DocumentStreamServlet</servlet-name>
        <url-pattern>/documentStream</url-pattern>
    </servlet-mapping>

    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>

</web-app>
